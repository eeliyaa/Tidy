<Window x:Class="Tidy.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tidy" Icon="pack://application:,,,/Tidy;component/Resources/tidy.ico" Width="930" Height="650" MinWidth="760" MinHeight="560" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,17">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <Image Source="pack://application:,,,/Tidy;component/Resources/tidy-logo.png" Width="154" Height="52" Stretch="Uniform" HorizontalAlignment="Left"/>
        <TextBlock Text="Keep your folders organized." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="3,-1,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="0.1.0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14,9" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Tidy;component/Resources/tidy-icon.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
          <TextBlock Text="SELECTED FOLDER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Text="{Binding FolderLabel}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" FlowDirection="LeftToRight"/>
        </StackPanel>
        <Button Grid.Column="2" Content="↻" Style="{StaticResource ActionButton}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Padding="10,7" MinWidth="38" Margin="10,0,0,0" ToolTip="Refresh preview" AutomationProperties.Name="Refresh preview"/>
        <Button Grid.Column="3" Content="Browse…" Style="{StaticResource ActionButton}" Click="Browse_Click" IsEnabled="{Binding CanBrowse}" MinWidth="94" Margin="8,0,0,0"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="14,0,10,10" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="FILES TO ORGANIZE" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CountSummary}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,4,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <TextBlock Text="FILE NAME" Margin="11,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="CATEGORY" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="DESTINATION" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
          </Grid>
          <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Plans}" Style="{StaticResource FileList}" AutomationProperties.Name="Files to organize">
              <ListBox.ItemTemplate><DataTemplate>
                <Grid Height="40" Margin="0" SnapsToDevicePixels="True">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding FileName}" Margin="9,0" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" FlowDirection="LeftToRight"/>
                  <TextBlock Text="{Binding Category}" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding RelativeDestination}" Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" FlowDirection="LeftToRight"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Style="{StaticResource ActionButton}" Background="Transparent" BorderThickness="0" Click="EmptyState_Click" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Choose a folder">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22">
                <Image Source="pack://application:,,,/Tidy;component/Resources/tidy-icon.png" Width="46" Height="46" Stretch="Uniform" Opacity="0.95" HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a folder" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,13,0,0"/>
                <TextBlock Text="Select a folder to see how Tidy will organize your files." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="320"/>
              </StackPanel>
            </Button>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" IsHitTestVisible="False" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="132" Height="3" IsIndeterminate="True" Foreground="{StaticResource GoldBrush}" Background="{StaticResource RaisedBrush}"/>
                <TextBlock Text="Scanning selected folder…" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="15,14,10,10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="CATEGORIES" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Files grouped by type" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource SoftScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="True">
              <ItemsControl ItemsSource="{Binding Categories}" FocusVisualStyle="{StaticResource FocusAccentMarker}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7,4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding CategoryEmptyMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,6,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCategories}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,15,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="12,9" Margin="0,0,12,0" VerticalAlignment="Center">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
          <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock Text="{Binding WarningSummary}" FontSize="9.5" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" ToolTip="{Binding WarningTooltip}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolVisibility}}" Margin="0,3,0,0"/><TextBlock Text="{Binding Error}" FontSize="9.5" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/></StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Undo Last Organization" Style="{StaticResource ActionButton}" Click="Undo_Click" IsEnabled="{Binding CanUndo}" MinWidth="175"/>
        <Button Content="Organize Files" Style="{StaticResource PrimaryButton}" Click="Organize_Click" IsEnabled="{Binding CanOrganize}" MinWidth="145" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
